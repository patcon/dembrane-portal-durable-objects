{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  // Skips what .gitignore does: node_modules, dist, .wrangler.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!env.d.ts"]
  },
  // Reads Tailwind's @tailwind in src/client/dembrane/index.css.
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConsole": "error" },
      "style": { "noNonNullAssertion": "error" }
    }
  },
  "overrides": [
    {
      // Copied from echo as is (scripts/echo-files.sh), in echo's own style,
      // so a diff against echo shows only what changed.
      "includes": ["src/client/dembrane/**", "tailwind.config.js", "!src/client/dembrane/shims/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // The Worker logs each transcript and extraction run to the terminal.
      "includes": ["src/server/**", "scripts/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
}
