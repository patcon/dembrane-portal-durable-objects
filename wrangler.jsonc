{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dembrane-portal-durable-objects",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The Vite plugin sets this itself, but noite reads this file directly.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "ProjectAgent", "name": "ProjectAgent" },
      { "class_name": "SessionAgent", "name": "SessionAgent" },
      { "class_name": "VerifyAgent", "name": "VerifyAgent" },
      { "class_name": "ExploreAgent", "name": "ExploreAgent" },
      { "class_name": "StatementsAgent", "name": "StatementsAgent" }
    ]
  },
  "main": "src/server/server.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "ProjectAgent",
        "SessionAgent",
        "VerifyAgent",
        "ExploreAgent",
        "StatementsAgent"
      ],
      "tag": "v1"
    }
  ]
}
